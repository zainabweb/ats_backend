# Copy this file to .env and fill in real values.

ENV=development
LOG_LEVEL=INFO

# HR-facing routes require this header: X-API-Key: <value>
ATS_API_KEY=changeme

# LLM - used for structuring resume fields, structuring work history, and scoring
# Gemini API - FREE tier, no credit card required. Get a key at:
# https://aistudio.google.com/apikey
# IMPORTANT: new keys are currently restricted to the 3.x model family -
# older models like gemini-2.5-flash return "no longer available to new
# users". gemini-3.1-flash-lite has the best free daily quota right now.
#
# Up to 3 Gemini keys (e.g. 3 separate free-tier Google accounts) can be set.
# GEMINI_API_KEY_2 / GEMINI_API_KEY_3 are OPTIONAL - leave blank to use just
# one key. As soon as a key hits its rate limit / daily quota, the next
# configured key is used automatically, in order.
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
LLM_MODEL=gemini-3.1-flash-lite

# OPTIONAL fallback - only used once EVERY configured Gemini key above is
# exhausted for the day. Leave all three blank to disable (Gemini-only, same
# as before). xAI's API has NO free tier - this is billed per token on your
# own xAI account if it ever triggers. Get a key at: https://console.x.ai
# GROK_API_KEY_2 / GROK_API_KEY_3 are OPTIONAL, rotated the same way as Gemini.
GROK_API_KEY=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_MODEL=grok-4.3

# Embeddings - local model by default, no key required
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB (the only database)
# mode = embedded -> writes to CHROMA_PERSIST_DIR directly, no server needed (default)
# mode = server   -> connects to a standalone ChromaDB server at CHROMA_HOST:CHROMA_PORT
CHROMA_MODE=embedded
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_HOST=localhost
CHROMA_PORT=8001
JOBS_COLLECTION=job_descriptions
RESUMES_COLLECTION=candidate_resumes

# File storage
STORAGE_DIR=./storage/resumes
MAX_FILE_SIZE_MB=5

DEFAULT_TOP_K=5
MAX_TOP_K=20
